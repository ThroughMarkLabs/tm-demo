#!/usr/bin/env bash
# Launch opencode with the ThroughMark WORK ID set, so many sessions map to one unit of work
# (see ATTRIBUTION.md). Default = current git branch; override with an explicit ticket:
#   tm-opencode              # work id = git branch
#   tm-opencode TM-123       # work id = the ticket
set -u
WORK="${1:-$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)}"
export TM_WORK="$WORK"
export TM_TRACE="$("$(dirname "$0")/tm-trace" "$WORK")"
echo "ThroughMark work id: $TM_WORK  trace id: $TM_TRACE  (sessions in this run attribute to it)"
exec opencode
