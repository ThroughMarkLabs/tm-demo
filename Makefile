VLI_SCRIPTS_DIR ?= /Users/andrew/Development/vli/Vitrevant-Labs-AI/scripts

hazards:       ## list candidate hazards awaiting promotion
	@python3 $(VLI_SCRIPTS_DIR)/compliance/promote_hazard.py --list

promote-haz:   ## make promote-haz CAND=HAZC-1 ID=HAZ-7 BY=you@example.com
	@python3 $(VLI_SCRIPTS_DIR)/compliance/promote_hazard.py --candidate "$(CAND)" --id "$(ID)" --by "$(BY)"

signoff-haz:   ## make signoff-haz ID=HAZ-7 BY=you@example.com
	@python3 $(VLI_SCRIPTS_DIR)/compliance/risk_analysis.py --signoff "$(ID)" --by "$(BY)"

requirements:  ## list candidate requirements awaiting promotion
	@python3 $(VLI_SCRIPTS_DIR)/compliance/promote_requirement.py --list

promote-req:   ## make promote-req CAND=CAND-3 ID=SRS-041 BY=you@example.com
	@python3 $(VLI_SCRIPTS_DIR)/compliance/promote_requirement.py --candidate "$(CAND)" --id "$(ID)" --by "$(BY)"

risk-report:   ## run the risk analysis report
	@python3 $(VLI_SCRIPTS_DIR)/compliance/risk_analysis.py

.PHONY: hazards promote-haz signoff-haz requirements promote-req risk-report
